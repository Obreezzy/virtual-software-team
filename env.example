# Copy this file to .env and fill in your values. Never commit .env.

# --- Option 1: local models with Ollama (free, no key needed) ---
# TEAM_MODEL=qwen2.5-coder:7b
# OLLAMA_URL=http://localhost:11434

# --- Option 2: a hosted OpenAI-compatible API (e.g. Groq) ---
# TEAM_API_BASE=https://api.groq.com/openai/v1
# TEAM_API_KEY=your-key-here
# TEAM_MODEL=your-model-name

# --- Optional tuning ---
# TEAM_MAX_ROUNDS=5
# TEAM_STRESS=1
# TEAM_USE_DOCKER=0
# TEAM_NUM_CTX=8192
# TEAM_MAX_TOKENS=
# TEAM_REQUEST_LIMIT=6500
# TEAM_REASONING_EFFORT=
# TEAM_DESIGN_REVIEW=1
# TEAM_DESIGN_CHECKS=2
# TEAM_TIMEOUT=900
